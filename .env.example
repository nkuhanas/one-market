# Copy to .env only when overriding the defaults.
WEB_PORT=5173
DB_PORT=3000
SPACETIMEDB_DATABASE=one-market-v02-local
# This URL is used by the browser, not by other containers.
VITE_SPACETIMEDB_HOST=http://localhost:3000
# Optional frontend-only target; does not redirect local publish/test scripts.
# VITE_SPACETIMEDB_DATABASE=one-market-v02-local
# VITE_* settings are public. Never prefix a publishing token with VITE_.
