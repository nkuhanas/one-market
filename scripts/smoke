#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

"$REPO_ROOT/scripts/local-up"

database="$(database_name)"
runtime_snapshot() {
  compose run --rm --no-deps tools spacetime --root-dir /state sql \
    --server http://db:3000 --no-config --format json "$database" \
    'SELECT tick FROM market_state'
  compose run --rm --no-deps tools spacetime --root-dir /state sql \
    --server http://db:3000 --no-config --format json "$database" \
    'SELECT * FROM tick_schedule'
}

before="$(runtime_snapshot)"
compose up -d --force-recreate --wait db
"$REPO_ROOT/scripts/local-publish"
after="$(runtime_snapshot)"
compose run --rm --no-deps -e BEFORE="$before" -e AFTER="$after" web node --input-type=module -e '
  import assert from "node:assert/strict";
  const parse = value => value.split("\n").filter(line => line.startsWith("[")).flatMap(line => JSON.parse(line));
  const before = parse(process.env.BEFORE);
  const after = parse(process.env.AFTER);
  assert(after[0].rows[0][0] >= before[0].rows[0][0], "Tick reset on restart");
  assert.equal(after[1].rows.length, 1, "Expected exactly one tick schedule");
  console.log("Persistent tick and single scheduler verified after recreation and republish.");
'

trap 'compose stop browser-web' EXIT
compose up -d --wait browser-web
compose run --rm --no-deps browser-tests
