#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

# Only creates a uniquely named LOCAL world. No reset/delete operation is used.
export UPGRADE_DATABASE="one-market-upgrade-test-$(date +%s)-$$"
compose up -d --wait db
compose run --rm --no-deps tools spacetime --root-dir /state publish \
  --server http://db:3000 --bin-path artifacts/builds/market-recovery/market-recovery.wasm \
  --no-config --delete-data=never --yes=remote,migrate,skip-login "$UPGRADE_DATABASE"
UPGRADE_BEFORE="$(compose run --rm --no-deps -e UPGRADE_DATABASE cloud-admin node scripts/upgrade-smoke.mjs prepare)"
export UPGRADE_BEFORE
"$REPO_ROOT/scripts/generate-bindings"
compose run --rm --no-deps tools spacetime --root-dir /state publish \
  --server http://db:3000 --bin-path target/wasm32-unknown-unknown/release/one_market_spacetime.wasm \
  --no-config --delete-data=never --yes=remote,migrate,skip-login "$UPGRADE_DATABASE"
UPGRADE_BEFORE="$(compose run --rm --no-deps -e UPGRADE_DATABASE -e UPGRADE_BEFORE cloud-admin node scripts/upgrade-smoke.mjs adopt)"
compose up -d --force-recreate --wait db
compose run --rm --no-deps -e UPGRADE_DATABASE -e UPGRADE_BEFORE cloud-admin node scripts/upgrade-smoke.mjs restart
