#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

: "${MAINCLOUD_SERVER:?Set the selected HTTPS Maincloud server URL}"
: "${MAINCLOUD_DATABASE:?Set the selected development database}"
: "${SPACETIMEDB_TOKEN:?Supply the authorized Maincloud publishing token}"
[[ "${CONFIRM_MAINCLOUD:-}" == publish ]] || { printf 'Set CONFIRM_MAINCLOUD=publish for the selected development database.\n' >&2; exit 1; }
[[ "$MAINCLOUD_SERVER" == https://* ]] || { printf 'Maincloud requires HTTPS.\n' >&2; exit 1; }
"$REPO_ROOT/scripts/generate-bindings"
# Authentication exists only in this temporary container; local identity is intact.
compose run --rm --no-deps -e SPACETIMEDB_TOKEN -e MAINCLOUD_SERVER -e MAINCLOUD_DATABASE tools sh -ec '
  spacetime --root-dir /tmp/one-market-cloud-cli login --token "$SPACETIMEDB_TOKEN" >/dev/null
  spacetime --root-dir /tmp/one-market-cloud-cli publish --server "$MAINCLOUD_SERVER" \
    --bin-path target/wasm32-unknown-unknown/release/one_market_spacetime.wasm \
    --no-config --delete-data=never --yes=remote,migrate,skip-login "$MAINCLOUD_DATABASE"
'
