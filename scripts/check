#!/usr/bin/env bash
source "$(dirname "$0")/common.sh"

compose build tools web
"$REPO_ROOT/scripts/check-maincloud-config"
compose run --rm --no-deps web npm ci --no-audit --no-fund
compose run --rm --no-deps web npm run format:check
compose run --rm --no-deps web npm run lint
compose run --rm --no-deps web node --test scripts/maincloud.test.mjs scripts/cadence.test.mjs scripts/candles.test.mjs
compose run --rm --no-deps web npm run typecheck
compose run --rm --no-deps web npm run build
compose run --rm --no-deps tools cargo fmt --all -- --check
compose run --rm --no-deps tools cargo test --locked -p one-market-core -p one-market-spacetime -p one-market-benchmark
compose run --rm --no-deps tools cargo clippy --locked -p one-market-spacetime -p one-market-core --target wasm32-unknown-unknown -- -D warnings
compose run --rm --no-deps tools cargo clippy --locked -p one-market-benchmark -- -D warnings
compose run --rm --no-deps tools spacetime --root-dir /state build --module-path crates/spacetime
compose run --rm --no-deps tools sh -ec '
  spacetime --root-dir /state generate --bin-path target/wasm32-unknown-unknown/release/one_market_spacetime.wasm \
    --lang typescript --out-dir /tmp/bindings --no-config --yes
  diff -ru packages/bindings/src /tmp/bindings
  spacetime --root-dir /state generate --bin-path target/wasm32-unknown-unknown/release/one_market_spacetime.wasm \
    --lang rust --include-private --out-dir /tmp/rust-bindings --no-config --yes
  diff -ru crates/benchmark/src/bindings /tmp/rust-bindings
'
